    def num(self, entry, label, lo=None, hi=None):
        try:
            x = float(entry.get().strip())
            if lo is not None and x < lo: raise ValueError
            if hi is not None and x > hi: raise ValueError
            return x
        except Exception:
            raise ValueError(f"Enter a valid {label}.")
def wellness(self, water, sleep, mood, hr):
        s = min(water / 8.0, 1.0) * 25
        s += max(0, 1 - abs(sleep - 8) / 8) * 25
        s += {"Happy": 25, "Normal": 18, "Sad": 10, "Stressed": 6}.get(mood.title(), 12)
        s += 15 if 60 <= hr <= 100 else 8
        return round(max(0, min(100, s)), 1)

    def save_record(self):
        try:
            water = self.num(self.water, "water", 0, 100)
            sleep = self.num(self.sleep, "sleep", 0, 24)
            hr = self.num(self.hr, "heart rate", 20, 250)
            weight = self.num(self.weight, "weight", 1, 500)
            height = self.num(self.height, "height", 30, 250)
            mood = self.mood.get().strip().title()
            if mood not in ("Happy", "Normal", "Sad", "Stressed"):
                raise ValueError("Mood must be Happy, Normal, Sad, or Stressed.")
            bmi = round(weight / ((height / 100) ** 2), 2)
            score = self.wellness(water, sleep, mood, hr)
            now = datetime.now()
            r = {
                "user": self.user, "datetime": now.strftime("%Y-%m-%d %H:%M"),
                "date": now.strftime("%Y-%m-%d"), "water": water, "sleep": sleep,
                "mood": mood, "heart_rate": hr, "weight": weight, "height": height,
                "bmi": bmi, "medicine": self.med.get().strip(),
                "symptoms": self.sym.get().strip(), "score": score
            }
            data["records"].append(r)
            save_data()
            self.bmi_label.config(text=f"BMI  {bmi:.2f}")
            self.score_label.config(text=f"SCORE  {score:.1f}")
            messagebox.showinfo("Saved", "Today's wellness record was saved.")
        except ValueError as e:
            messagebox.showwarning("Check input", str(e))

