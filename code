def load_data():
    if not os.path.exists(DATA_FILE):
        return {"users": {}, "records": []}
    try:
        with open(DATA_FILE, "r", encoding="utf-8") as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {"users": {}, "records": []}
    except Exception:
        return {"users": {}, "records": []}

