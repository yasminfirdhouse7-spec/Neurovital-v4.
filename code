    def ml(self):
        self.clear()
        self.header(self.root, "ML Analysis", self.dashboard)
        wrap, frame = self.scroll(self.root)
        wrap.pack(fill="both", expand=True)
        tk.Label(frame, text="ML ANALYSIS", bg=BG, fg=FG,
                 font=("Arial", 17, "bold")).pack(anchor="w", padx=16, pady=(8, 1))
        tk.Label(frame, text="Synthetic educational demonstration",
                 bg=BG, fg=MUTED, font=("Arial", 9)).pack(anchor="w", padx=16, pady=(0, 8))

        X, y = [], []
        rng = np.random.default_rng(42)
        for _ in range(600):
            water = rng.uniform(1, 12)
            sleep = rng.uniform(3, 11)
            hr = rng.uniform(50, 120)
            mood = rng.choice([0, 1, 2, 3])
            target = int((water >= 6) + (6 <= sleep <= 9) +
                         (60 <= hr <= 100) + (mood in [0, 1]) >= 3)
            X.append([water, sleep, hr, mood])
            y.append(target)
        X, y = np.array(X), np.array(y)
        Xtr, Xte, ytr, yte = train_test_split(
            X, y, test_size=.25, random_state=42, stratify=y)
