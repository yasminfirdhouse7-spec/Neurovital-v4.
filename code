    def graph(self, kind):
        rs = self.latest7()
        if not rs:
            return
        labels = [r["date"][5:] for r in rs]
        plt.rcParams.update({
            "figure.facecolor": "#0b1017", "axes.facecolor": "#141c26",
            "axes.edgecolor": "#34465a", "axes.labelcolor": "#dbe5ef",
            "xtick.color": "#aebdcb", "ytick.color": "#aebdcb",
            "text.color": "#f3f6fa", "grid.color": "#263444"
        })
        if kind == "water":
            fig, ax = plt.subplots(figsize=(7, 4))
            ax.bar(labels, [r["water"] for r in rs])
            ax.set_title("Water intake", fontsize=14, fontweight="bold")
            ax.set_ylabel("Glasses")
            ax.grid(axis="y", alpha=.35)
        elif kind == "line":
            fig, ax = plt.subplots(figsize=(7, 4))
            ax.plot(labels, [r["sleep"] for r in rs], marker="o", linewidth=2, label="Sleep (h)")
            ax.plot(labels, [r["score"] / 10 for r in rs], marker="o", linewidth=2, label="Score / 10")
            ax.set_title("Sleep and wellness score", fontsize=14, fontweight="bold")
            ax.set_ylabel("Value")
            ax.grid(alpha=.25)
            ax.legend(frameon=False)
        elif kind == "hist":
            fig, ax = plt.subplots(figsize=(7, 4))
            ax.hist([r["sleep"] for r in rs], bins=max(3, min(7, len(rs))), alpha=.8)
            ax.set_title("Sleep distribution", fontsize=14, fontweight="bold")
            ax.set_xlabel("Sleep hours")
            ax.set_ylabel("Frequency")
            ax.grid(axis="y", alpha=.25)
        else:
            counts = {}
            for r in rs:
                counts[r["mood"]] = counts.get(r["mood"], 0) + 1
            fig, ax = plt.subplots(figsize=(6, 6))
            ax.pie(list(counts.values()), labels=list(counts.keys()), autopct="%1.0f%%")
            ax.set_title("Mood proportion", fontsize=14, fontweight="bold")
        fig.tight_layout()
        plt.show()
